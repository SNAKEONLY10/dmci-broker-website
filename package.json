{
  "name": "dmci-broker-website",
  "version": "1.0.0",
  "private": true,
  "description": "Premium DMCI Homes buyer assistance website for Luisa Corral.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/write-build-info.mjs && vite build && node scripts/generate-seo-pages.mjs",
    "assets:optimize": "node scripts/optimize-project-images.mjs",
    "inventory:routes": "node scripts/write-route-inventory.mjs",
    "qa:routes": "node scripts/validate-seo-routes.mjs",
    "qa:images": "node scripts/validate-project-images.mjs",
    "qa:links": "node scripts/validate-internal-links.mjs",
    "qa:external-links": "node scripts/audit-external-links.mjs",
    "qa:external-links:live": "node scripts/check-external-links-live.mjs",
    "qa:project-link-policy": "node scripts/validate-project-link-policy.mjs",
    "qa:api": "node scripts/test-leads-api.mjs",
    "qa:production": "npm run build && npm run qa:api && npm run qa:routes && npm run qa:images && npm run qa:links && npm run qa:external-links && npm run qa:project-link-policy && npm run inventory:routes",
    "email:preview": "node scripts/render-lead-email-preview.mjs",
    "email:qa:check": "node scripts/send-form-qa-emails.mjs check",
    "email:qa:send": "node scripts/send-form-qa-emails.mjs send",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "sharp": "^0.35.2"
  }
}
