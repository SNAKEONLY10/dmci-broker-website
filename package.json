{
  "name": "dmci-broker-website",
  "version": "1.0.0",
  "private": true,
  "description": "Premium DMCI Homes buyer assistance website for Luisa Corral.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo-pages.mjs",
    "assets:optimize": "node scripts/optimize-project-images.mjs",
    "inventory:routes": "node scripts/write-route-inventory.mjs",
    "qa:routes": "node scripts/validate-seo-routes.mjs",
    "qa:images": "node scripts/validate-project-images.mjs",
