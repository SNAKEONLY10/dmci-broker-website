{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/contact`",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/contact%60",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/locations/pasig",
      "destination": "/locations/pasig-city",
      "permanent": true
    },
    {
      "source": "/locations/mandaluyong",
      "destination": "/locations/mandaluyong-city",
      "permanent": true
    },
    {
      "source": "/locations/taguig",
      "destination": "/locations/taguig-city",
      "permanent": true
    },
    {
      "source": "/locations/pasay",
      "destination": "/locations/pasay-city",
      "permanent": true
    },
    {
      "source": "/locations/paranaque",
      "destination": "/locations/paranaque-city",
      "permanent": true
    },
    {
      "source": "/locations/las-pinas",
      "destination": "/locations/las-pinas-city",
      "permanent": true
    },
    {
      "source": "/locations/baguio-city-benguet",
      "destination": "/locations/baguio-city",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
